diff --git a/src/graphics/host_gpu/renderer/fsr4.cpp b/src/graphics/host_gpu/renderer/fsr4.cpp
new file mode 100644
index 00000000..3f03d03e
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/fsr4.cpp
@@ -0,0 +1,335 @@
+// Native FSR 4.1.2 through the FidelityFX SDK Vulkan provider.
+//
+// The provider is an optional, externally built GPL-3.0 library (the local
+// FidelityFX SDK port).  Kyty only calls its FFX API; no provider source or
+// extracted assets are part of this tree.
+//
+// SPDX-License-Identifier: GPL-2.0
+
+#include "graphics/host_gpu/renderer/fsr4.h"
+
+#include "graphics/host_gpu/renderer/dlss.h"
+#include "graphics/host_gpu/renderer/image/image.h"
+#include "graphics/host_gpu/renderer/render.h"
+#include "graphics/host_gpu/renderer/renderContext.h"
+#include "graphics/host_gpu/vulkanCommon.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#if !defined(_WIN32)
+#define __declspec(x)
+#include "ffx_api.h"
+#include "ffx_upscale.h"
+#include "vk/ffx_api_vk.h"
+
+#include <dlfcn.h>
+#endif
+
+namespace Libs::Graphics {
+
+namespace Fsr4 {
+
+bool Requested() {
+	static const bool requested = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+	return requested;
+}
+
+void RequiredExtensions(std::vector<const char*>& instance, std::vector<const char*>& device) {
+	(void)instance;
+#if !defined(_WIN32)
+	if (!Requested()) {
+		return;
+	}
+	device.push_back(VK_KHR_COOPERATIVE_MATRIX_EXTENSION_NAME);
+	device.push_back(VK_EXT_SHADER_FLOAT8_EXTENSION_NAME);
+#else
+	(void)device;
+#endif
+}
+
+} // namespace Fsr4
+
+#if !defined(_WIN32)
+
+namespace {
+
+struct State {
+	bool                 init_tried = false;
+	bool                 ready      = false;
+	void*                loader     = nullptr;
+	PfnFfxCreateContext  create     = nullptr;
+	PfnFfxDestroyContext destroy    = nullptr;
+	PfnFfxDispatch       dispatch   = nullptr;
+	ffxContext           context    = nullptr;
+	uint32_t             in_w       = 0;
+	uint32_t             in_h       = 0;
+	uint32_t             out_w      = 0;
+	uint32_t             out_h      = 0;
+	uint64_t             last_frame = 0;
+	uint64_t             last_dispatch_frame = 0;
+};
+
+State& Get() {
+	static State state;
+	return state;
+}
+
+std::string ProviderDirectory() {
+	const char* value = std::getenv("ASTROHYBRID_FSR4_PATH");
+	return value != nullptr && value[0] != '\0' ? std::string(value) : std::string("fsr4");
+}
+
+bool LoadProvider(State& s) {
+	if (s.init_tried) {
+		return s.ready;
+	}
+	s.init_tried = true;
+
+	const auto  directory = ProviderDirectory();
+	const auto  loader_path = directory + "/libamd_fidelityfx_loader_vk.so";
+	const auto  asset_dir = directory + "/assets";
+	if (std::getenv("FSR4_ASSET_DIR") == nullptr) {
+		setenv("FSR4_ASSET_DIR", asset_dir.c_str(), 1);
+	}
+	s.loader = dlopen(loader_path.c_str(), RTLD_NOW | RTLD_LOCAL);
+	if (s.loader == nullptr) {
+		std::printf("FSR4: cannot load %s: %s\n", loader_path.c_str(), dlerror());
+		std::fflush(stdout);
+		return false;
+	}
+	s.create = reinterpret_cast<PfnFfxCreateContext>(dlsym(s.loader, "ffxCreateContext"));
+	s.destroy = reinterpret_cast<PfnFfxDestroyContext>(dlsym(s.loader, "ffxDestroyContext"));
+	s.dispatch = reinterpret_cast<PfnFfxDispatch>(dlsym(s.loader, "ffxDispatch"));
+	if (s.create == nullptr || s.destroy == nullptr || s.dispatch == nullptr) {
+		std::printf("FSR4: %s is missing the FFX entry points\n", loader_path.c_str());
+		std::fflush(stdout);
+		return false;
+	}
+	return true;
+}
+
+bool CreateContext(State& s, const GraphicContext& graphics, uint32_t in_w, uint32_t in_h,
+                   uint32_t out_w, uint32_t out_h) {
+	if (s.create == nullptr) {
+		return false;
+	}
+	if (s.context != nullptr) {
+		return true;
+	}
+
+	VkDeviceContext device_context {};
+	device_context.vkDevice         = static_cast<VkDevice>(graphics.device);
+	device_context.vkPhysicalDevice = static_cast<VkPhysicalDevice>(graphics.physical_device);
+	device_context.vkDeviceProcAddr = VULKAN_HPP_DEFAULT_DISPATCHER.vkGetDeviceProcAddr;
+
+	ffxCreateBackendVKDesc backend {};
+	backend.header.type          = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+	backend.deviceContext        = device_context;
+
+	ffxCreateContextDescUpscaleVersion version {};
+	version.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE_VERSION;
+	version.version     = FFX_UPSCALER_VERSION;
+
+	ffxCreateContextDescUpscale upscale {};
+	upscale.header.type   = FFX_API_CREATE_CONTEXT_DESC_TYPE_UPSCALE;
+	upscale.maxRenderSize = {in_w, in_h};
+	upscale.maxUpscaleSize = {out_w, out_h};
+	upscale.flags          = 0;
+	upscale.fpMessage      = nullptr;
+	upscale.header.pNext   = &version.header;
+	version.header.pNext   = &backend.header;
+
+	const auto result = s.create(&s.context, &upscale.header, nullptr);
+	if (result != FFX_API_RETURN_OK || s.context == nullptr) {
+		std::printf("FSR4: ffxCreateContext failed (0x%x) for %ux%u -> %ux%u\n",
+		            static_cast<unsigned>(result), in_w, in_h, out_w, out_h);
+		std::fflush(stdout);
+		s.context = nullptr;
+		s.ready   = false;
+		return false;
+	}
+	s.in_w   = in_w;
+	s.in_h   = in_h;
+	s.out_w  = out_w;
+	s.out_h  = out_h;
+	s.ready  = true;
+	std::printf("FSR4: context created, %ux%u -> %ux%u\n", in_w, in_h, out_w, out_h);
+	std::fflush(stdout);
+	return true;
+}
+
+FfxApiResourceDescription DescribeImage(const Image& image, uint32_t additional_usages) {
+	VkImageCreateInfo create {};
+	create.sType         = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	create.imageType     = VK_IMAGE_TYPE_2D;
+	create.format        = static_cast<VkFormat>(image.backing.format);
+	create.extent        = {image.info.extent.width, image.info.extent.height, 1};
+	create.mipLevels     = 1;
+	create.arrayLayers   = 1;
+	create.samples       = VK_SAMPLE_COUNT_1_BIT;
+	create.tiling        = VK_IMAGE_TILING_OPTIMAL;
+	create.usage         = static_cast<VkImageUsageFlags>(image.backing.usage) | additional_usages;
+	create.sharingMode   = VK_SHARING_MODE_EXCLUSIVE;
+	create.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	return ffxApiGetImageResourceDescriptionVK(static_cast<VkImage>(image.backing.image),
+	                                           create, additional_usages);
+}
+
+} // namespace
+
+bool RenderExecutor::TryFsr4Upscale(CommandBuffer& buffer, PreparedBindings& pixel, ImageId output) {
+	if (!Fsr4::Requested() || pixel.runtime == nullptr || !*pixel.runtime) {
+		return false;
+	}
+	static const uint64_t pass_hash = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PASS");
+		return value != nullptr ? std::strtoull(value, nullptr, 0) : 0x2936e5eca99d75e7ull;
+	}();
+	if (pixel.runtime->program->shader_hash != pass_hash) {
+		return false;
+	}
+	if (pixel.images.size() < 2 || !output || pixel.buffer_sources.empty() ||
+	    pixel.buffer_sources[0].address == 0 || pixel.buffer_sources[0].size < 56) {
+		return false;
+	}
+
+	auto& s = Get();
+	const auto* cb = reinterpret_cast<const uint32_t*>(pixel.buffer_sources[0].address);
+	float       jitter_uv[2];
+	std::memcpy(jitter_uv, cb, sizeof(jitter_uv));
+	const uint32_t out_w = cb[4], out_h = cb[5], in_w = cb[6], in_h = cb[7], frame = cb[11];
+	if (cb[13] == 0 || in_w == 0 || in_h == 0 || out_w == 0 || out_h == 0) {
+		return false;
+	}
+	// The game uses the same upscale shader for intermediate and 1:1 passes. FSR4 is only
+	// meaningful for the final 4K scene upscale, once per frame.
+	constexpr uint32_t kTargetWidth = 3840;
+	constexpr uint32_t kTargetHeight = 2160;
+	if (out_w != kTargetWidth || out_h != kTargetHeight || in_w >= out_w || in_h >= out_h) {
+		return false;
+	}
+	if (s.last_dispatch_frame == frame) {
+		return false;
+	}
+
+	auto&      cache      = m_context.GetTextureCache();
+	const auto mv_id      = pixel.images[0].image_id;
+	const auto color_id   = pixel.images[1].image_id;
+	const auto depth_id   = DepthForColor(mv_id);
+	if (!depth_id || cache.m_slot_images.try_get(depth_id) == nullptr) {
+		return false;
+	}
+	auto& mv    = cache.GetImage(mv_id);
+	auto& color = cache.GetImage(color_id);
+	auto& depth = cache.GetImage(depth_id);
+	auto& out   = cache.GetImage(output);
+	const auto same = [](const Image& image, uint32_t w, uint32_t h) {
+		return image.info.extent.width == w && image.info.extent.height == h &&
+		       image.backing.image != nullptr && image.info.samples == 1;
+	};
+	if (!same(mv, in_w, in_h) || !same(color, in_w, in_h) || !same(depth, in_w, in_h) ||
+	    !same(out, out_w, out_h) || !depth.info.IsDepth() ||
+	    !(out.backing.usage & vk::ImageUsageFlagBits::eStorage)) {
+		return false;
+	}
+
+	if (!LoadProvider(s)) {
+		return false;
+	}
+	auto& graphics = m_context.GetGraphics();
+	if (!CreateContext(s, graphics, 3840, 2160, 3840, 2160)) {
+		return false;
+	}
+
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+
+	mv.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	color.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	depth.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderSampledRead, {}, cmd);
+	out.Transit(vk::ImageLayout::eGeneral,
+	            vk::AccessFlagBits2::eShaderStorageRead | vk::AccessFlagBits2::eShaderStorageWrite, {},
+	            cmd);
+
+	const auto resource = [](const Image& image, uint32_t extra, VkImageLayout layout) {
+		return ffxApiGetResourceVK(static_cast<VkImage>(image.backing.image),
+		                           DescribeImage(image, extra), static_cast<uint32_t>(layout));
+	};
+
+	ffxDispatchDescUpscale desc {};
+	desc.header.type       = FFX_API_DISPATCH_DESC_TYPE_UPSCALE;
+	desc.commandList       = cmd;
+	desc.color             = resource(color, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.depth             = resource(depth, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.motionVectors     = resource(mv, 0, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+	desc.output            = resource(out, VK_IMAGE_USAGE_STORAGE_BIT, VK_IMAGE_LAYOUT_GENERAL);
+	desc.renderSize        = {in_w, in_h};
+	desc.upscaleSize       = {out_w, out_h};
+
+	static const float mv_sign = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_MV_SIGN");
+		return value != nullptr ? std::strtof(value, nullptr) : -1.0f;
+	}();
+	static const float pre_exposure = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_PRE_EXPOSURE");
+		return value != nullptr ? std::strtof(value, nullptr) : 1.0f;
+	}();
+	static const float camera_near = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_NEAR");
+		return value != nullptr ? std::strtof(value, nullptr) : 0.1f;
+	}();
+	static const float camera_far = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_FAR");
+		return value != nullptr ? std::strtof(value, nullptr) : 1000.0f;
+	}();
+	static const bool sharpening = [] {
+		const char* value = std::getenv("ASTROHYBRID_FSR4_SHARPEN");
+		return value != nullptr && std::strcmp(value, "1") == 0;
+	}();
+
+	desc.motionVectorScale    = {mv_sign * static_cast<float>(in_w),
+	                             mv_sign * static_cast<float>(in_h)};
+	desc.jitterOffset         = {jitter_uv[0] * static_cast<float>(in_w),
+	                             jitter_uv[1] * static_cast<float>(in_h)};
+	desc.enableSharpening     = sharpening;
+	desc.sharpness            = sharpening ? 0.2f : 0.0f;
+	desc.frameTimeDelta       = 16.7f;
+	desc.preExposure          = pre_exposure;
+	desc.reset                = s.last_frame != 0 && frame != s.last_frame + 1;
+	desc.cameraNear           = camera_near;
+	desc.cameraFar            = camera_far;
+	desc.cameraFovAngleVertical = 1.0472f;
+	desc.viewSpaceToMetersFactor = 1.0f;
+	desc.flags                = 0;
+
+	static uint32_t debug = 0;
+	if (debug++ < 8) {
+		std::printf("FSR4: dispatch frame=%u %ux%u -> %ux%u\n", frame, in_w, in_h, out_w, out_h);
+		std::fflush(stdout);
+	}
+	s.last_frame = frame;
+	const auto result = s.dispatch(&s.context, &desc.header);
+	buffer.ForgetBoundState();
+	if (result != FFX_API_RETURN_OK) {
+		static uint32_t logged = 0;
+		if (logged++ < 8) {
+			std::printf("FSR4: ffxDispatch failed (0x%x)\n", static_cast<unsigned>(result));
+			std::fflush(stdout);
+		}
+		return false;
+	}
+	s.last_dispatch_frame = frame;
+	return true;
+}
+
+#endif // !defined(_WIN32)
+
+} // namespace Libs::Graphics
